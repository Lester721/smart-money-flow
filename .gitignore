# Bitácora de mensajes de Telegram (datos, no código)
web/data/telegram-mensajes.jsonl

# Salidas generadas por los analisis: se rehacen corriendo el script y pesan cientos de MB
web/scripts/10x-resumen.json
web/scripts/eva-largo-*.json
web/scripts/puente-filas.json

# Borradores de una sola corrida: los scripts de comprobacion que se escriben para mirar una
# cosa y no se vuelven a usar. La convencion es el guion bajo delante.
web/scripts/_*
