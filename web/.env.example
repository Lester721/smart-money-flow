# Copia este archivo a .env.local y pon tus valores reales.

# --- Massive (datos de opciones) ---
MASSIVE_API_KEY=tu_api_key_de_massive
MASSIVE_MAX_PAGES=40

# --- Redis (búfer del escáner /ideas de todo el mercado) ---
# La app LEE aquí el flujo notable que el worker (web/worker/ideasWorker.ts) escribe.
# En Railway lo pone el plugin de Redis; en local, apunta a la URL pública de ese mismo Redis.
REDIS_URL=redis://default:password@host:puerto

# Piso de premium para considerar un trade "notable" (debe coincidir con el del worker).
# Opcional: por defecto 500000 (dinero institucional).
IDEAS_MIN_PREMIUM=500000
