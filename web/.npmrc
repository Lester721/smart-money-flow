# Silencia el ruido de npm en los logs de Railway.
#
# Cada corrida de un forward-test escupía 3-4 líneas de "npm notice: New version available",
# que Railway cuenta como avisos en el contador ⚠ del servicio. Son ruido puro: no dicen nada
# del trabajo y tapan los avisos que SÍ importan.
#
# Lo que NO se silencia, a propósito: nuestros propios `⚠` (barras que no se pudieron bajar,
# meses sin open interest…). Esos son la razón por la que hoy supimos que 16 puts no podían
# liquidar. Un fallo que no se queja se lee como que todo va bien.
update-notifier=false
fund=false
audit=false
