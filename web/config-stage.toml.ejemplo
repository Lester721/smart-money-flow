# CONFIG PARA CORRER UN SEGUNDO TERMINAL A LA VEZ QUE RAILWAY
#
# Cópialo a `config.toml` (que está en .gitignore, así que es sólo tuyo y NO llega a Railway):
#
#     cp config-stage.toml.ejemplo config.toml
#
# POR QUÉ. ThetaData permite **una sola sesión activa por cuenta**: si un segundo Terminal entra
# con las mismas credenciales, invalida la primera. Nos costó varias horas el 2026-08-14 —
# la descarga local moría cada vez que Railway corría un cron, con este error:
#
#     ERROR: MDDS upstream unavailable: io exception       (el que se queda fuera)
#     HTTP 478 = INVALID_SESSION_ID                        (sus peticiones fallan)
#
# LA VÍA OFICIAL, confirmada por el soporte de ThetaData el 2026-08-15:
#
#   "Each account supports one active session at a time. […] The supported way to run two
#    connections simultaneously is to use the staging environment for the second one. You can
#    run two Terminals side-by-side by giving each its own config and setting
#    mdds_type = "STAGE" for the second instance."
#
# Reparto: **Railway se queda en PROD** (escribe su propio config por defecto) y **lo local va a
# STAGE**. Así la descarga y los forward-tests dejan de pisarse.
#
# ✅ COMPROBADO EL 2026-08-15 — STAGE devuelve EXACTAMENTE los mismos datos que PROD.
#
# Se levantaron los dos Terminales a la vez (PROD en 25503, STAGE en 25504) y se pidió el mismo
# dato por las dos vías, comparando el fichero entero con md5:
#
#   cadena de opciones de HOOD ..... 1.995 filas    idénticas
#   interés abierto de HOOD ........ 1.949 filas    idénticas
#   barras diarias de SPY .............. 6 filas    idénticas
#   operaciones 0DTE de SPXW ..... 1.001.611 filas  idénticas
#   vencimientos listados de SPY ... 2.109 filas    idénticas
#
# Ninguna diferencia, ni una fila. No hay datos parciales.
#
# Y LOS DOS CONVIVEN: con PROD ya corriendo, el segundo Terminal arrancó en STAGE sin invalidar
# la sesión del primero. Los dos sirvieron datos a la vez.
#
# EL WEBSOCKET TAMBIÉN VA EN STAGE (comprobado abriendo ws://127.0.0.1:25520/v1/events con sólo
# STAGE levantado). Eso es lo que permite mover el worker de Ideas a ThetaData y cancelar Massive.
#
# ⚠️ UN DETALLE DE LA PRUEBA EN LOCAL: los dos Terminales quieren el puerto 25520 para el
# websocket, y el segundo no lo consigue ("Address already in use"). El HTTP sí funciona en los
# dos porque el puerto se cambia en este fichero. En Railway NO pasa: cada servicio va en su
# propio contenedor, con su propia red.

host = "0.0.0.0"
port = 25503
log_directory = "/tmp"

[env]
mdds_type = "STAGE"          # ← lo único que cambia respecto al de producción

[auth]
base_url = "https://nexus-api.thetadata.us/identity/terminal/auth_user"

[mdds]
enable = true

[mdds_server]
host = "mdds-01.thetadata.us"
port = 443
tls = true
